[sub_resource type="GDScript" id="GDScript_4o78i"]
script/source = "extends Label


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	pass # Replace with function body.


# Called every frame. 'delta' is the elapsed time since the previous frame.
func _process(_delta: float) -> void:
	if get_meta(\"tasknumb\") == 2:
		text = \"Current task:\\nFind tablet with wireshark app\"
	elif get_meta(\"tasknumb\") == 3:
		text = \"Current task:\\nStart catching\"
	elif get_meta(\"tasknumb\") == 4:
		text = \"Current task:\\nFind the right packet\\nGo to PC with terminal\\nEnter passcode\"
	elif get_meta(\"tasknumb\") == 5:
		text = \"Current task:\\nComplete first minigame\\nGet a flag type:\\nmshellctf{flag}\"
	elif get_meta(\"tasknumb\") == 6:
		text = \"Current task:\\nFind the metadata minigame\"
	elif get_meta(\"tasknumb\") == 7:
		text = \"Current task:\\nGo to PC with terminal\"
	elif get_meta(\"tasknumb\") == 8:
		text = \"Current task:\\nFind the flag in passwords\"
	elif get_meta(\"tasknumb\") == 9:
		text = \"Current task:\\nFing PC with browser\"
	elif get_meta(\"tasknumb\") == 10:
		text = \"Current task:\\nFind 4 flag\"
	elif get_meta(\"tasknumb\") == 11:
		text = \"Current task:\\nGo to exit\"
	elif get_meta(\"tasknumb\") == 12:
		text = \"Current task:\\nEnter 4 flags to finish game\"
"

